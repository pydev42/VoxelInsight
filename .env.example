# LLM provider selection
# Supported: openai, anthropic, bedrock, ollama
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Bedrock (used when LLM_PROVIDER=bedrock)
BEDROCK_AWS_REGION=us-east-1
# Bedrock auth uses the standard boto3/AWS credential chain.
# The Bedrock model is currently selected in core/llm_provider.py.

# Ollama (used when LLM_PROVIDER=ollama) - for edge/on-device usage
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_API_KEY=ollama

# Optional supervisor override
# SUPERVISOR_LLM_MODEL=gpt-5.6-luna

# Optional DeepAgents-specific OpenAI model overrides
# DEEPAGENT_SUPERVISOR_LLM_MODEL=gpt-5.6-terra
# DEEPAGENT_SUBAGENT_LLM_MODEL=gpt-5.6-luna

# Edge/On-device mode
# Set to true to disable cloud repos (MIDRC/IDC/TCIA), auth, and require local data
EDGE_MODE=false
LOCAL_DATA_DIR=./data
LOCAL_INDEX_PATH=./.voxelinsight_local_index

